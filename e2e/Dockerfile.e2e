# =============================================================================
# FSAMP E2E Test Runner
# =============================================================================
# Lightweight container for running end-to-end tests against the FSAMP stack.
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    boto3>=1.35.0 \
    requests>=2.32.0 \
    pytest>=8.0.0 \
    pytest-timeout>=2.3.0 \
    tenacity>=8.2.0

# Copy test files
COPY tests/ /app/tests/
COPY run-e2e-tests.py /app/

# Run tests
ENTRYPOINT ["python", "run-e2e-tests.py"]
