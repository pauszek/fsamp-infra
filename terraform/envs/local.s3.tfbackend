# Terraform state in LocalStack Pro S3 - the local environment mirrors the
# AWS flow (remote state + locking) instead of using throwaway local state.
# The state bucket is created by `make init-local`.
bucket                      = "fsamp-local-tf-state"
key                         = "local/terraform.tfstate"
region                      = "us-west-2"
access_key                  = "test"
secret_key                  = "test"
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
use_path_style              = true
use_lockfile                = true

endpoints = {
  s3  = "http://localhost:4566"
  sts = "http://localhost:4566"
  iam = "http://localhost:4566"
}
