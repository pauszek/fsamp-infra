# LocalStack Pro authentication
# =============================================================================
# FSAMP Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LocalStack Pro (required for local development)
# -----------------------------------------------------------------------------
# Get your token at: https://app.localstack.cloud/
LOCALSTACK_AUTH_TOKEN=your-localstack-pro-token-here

# -----------------------------------------------------------------------------
# AWS Configuration (for dev/prod deployment)
# -----------------------------------------------------------------------------
AWS_PROFILE=fsamp-dev
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=     # Alternative to AWS_PROFILE
# AWS_SECRET_ACCESS_KEY= # Alternative to AWS_PROFILE

# -----------------------------------------------------------------------------
# Terraform Configuration
# -----------------------------------------------------------------------------
TF_VAR_environment=local
TF_VAR_project_name=fsamp
TF_VAR_aws_region=eu-central-1

# Terraform Backend (for dev/prod - S3 backend)
TF_STATE_BUCKET=fsamp-terraform-state
TF_LOCK_TABLE=fsamp-terraform-locks

# -----------------------------------------------------------------------------
# Docker Images (for E2E tests)
# -----------------------------------------------------------------------------
GATEWAY_IMAGE=ghcr.io/pauszek/fsamp-gateway:latest
PROCESSOR_IMAGE=ghcr.io/pauszek/fsamp-processor:latest
E2E_IMAGE=ghcr.io/pauszek/fsamp-e2e:latest

# -----------------------------------------------------------------------------
# LocalStack Configuration (optional overrides)
# -----------------------------------------------------------------------------
# LOCALSTACK_PORT=4566
# LOCALSTACK_HTTPS_PORT=443
# PERSISTENCE=1
# DEBUG=0
# ENFORCE_IAM=1
# IAM_SOFT_MODE=1
# EAGER_SERVICE_LOADING=1

# Optional: AWS credentials for real AWS deployment
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=fsamp-dev
