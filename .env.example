# FSAMP Infrastructure - Environment Variables
# Copy this file to .env:
#   cp .env.example .env
# LocalStack Pro (required for local development)
LOCALSTACK_AUTH_TOKEN=your-localstack-pro-token-here
# AWS Configuration
AWS_REGION=us-west-2
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# LocalStack (optional overrides)
# PERSISTENCE=1
# DEBUG=0
